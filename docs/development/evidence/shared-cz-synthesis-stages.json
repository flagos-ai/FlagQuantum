e') if iteration%2==0 else ('candidate','baseline')):\n            started=time.perf_counter();result=run(variant);elapsed=time.perf_counter()-started\n            samples[variant].append(elapsed)\n            outputs[variant]=result\n    assert outputs['baseline']==outputs['candidate']\n    errors={}\n    for variant,(proposal,reasons) in outputs.items():\n        if proposal is not None:\n            expected=propagate(2,normalize(instructions),np.eye(4,dtype=complex))\n            actual=propagate(2,normalize(proposal),np.eye(4,dtype=complex))\n            errors[variant]=equivalent(actual,expected,1e-10,1e-10)\n    peaks={};counts={}\n    for variant in ('baseline','candidate'):\n        tracemalloc.start()\n        try:run(variant);peaks[variant]=tracemalloc.get_traced_memory()[1]\n        finally:tracemalloc.stop()\n        profile=cProfile.Profile();profile.enable();run(variant);profile.disable()\n        stats=pstats.Stats(profile).stats\n        counts[variant]={name:sum(nc for (file,line,fn),(cc,nc,tt,ct,callers) in stats.items() if fn==name) for name in ('_weyl_decomposition','_local_leaves')}\n    assert counts['baseline']['_weyl_decomposition']==counts['candidate']['_weyl_decomposition']==1\n    proposal,reasons=outputs['candidate']\n    row={'case':previous['case'],'input':previous['input'],'proposal':None if proposal is None else normalize(proposal),'rejections':reasons,'independent_full_operator_residual':errors,'samples_seconds':samples,'median_seconds':{v:statistics.median(s) for v,s in samples.items()},'traced_python_peak_bytes':peaks,'profile_calls':counts}\n    rows.append(row);print(json.dumps(row),flush=True)\nout.write_text(json.dumps({'scope':'Inspected stage controls, not whole compilation or qualified timing','source_cases':'cz-cost-pruning-reduction-controls.json, all six unchanged cases','rows':rows,'driver_source':Path(__file__).read_text()},indent=2)+'\\n')\n"}
