  "driver_source": "from __future__ import annotations\n\nimport ast\nimport dataclasses\nimport hashlib\nimport json\nimport subprocess\nfrom pathlib import Path\nfrom unittest.mock import patch\nfrom benchmarks.compiler_sabre_trials import _program, _metrics\nfrom flagquantum.compiler import CouplingMap\nfrom flagquantum.compiler.topology import sabre\n\nrevision = '1dc11c0a5607f32a89032ca779f8c37d1b79e07e'\nsource = subprocess.check_output(['git', 'show', revision+':flagquantum/compiler/topology/sabre.py'], text=True, timeout=20)\nnode = next(node for node in ast.parse(source).body if isinstance(node, ast.FunctionDef) and node.name == '_select_sabre_trials')\nnamespace = dict(vars(sabre))\nexec(compile(ast.Module(body=[node], type_ignores=[]), '<integrated-selector>', 'exec'), namespace)\nold = namespace['_select_sabre_trials']\nrows = []\nfor width in (6, 8, 12, 16):\n    for topology in ('line', 'grid'):\n        coupling = CouplingMap.line(width) if topology == 'line' else CouplingMap.grid(2, width//2)\n        for seed in range(10):\n            program = _program(width, seed)\n            with patch.object(sabre, '_select_sabre_trials', old):\n                before = sabre.plan_sabre_swaps(program, coupling)\n            after = sabre.plan_sabre_swaps(program, coupling)\n            assert before == after\n            metrics = _metrics(program, coupling, after)\n            digest = hashlib.sha256(json.dumps(dataclasses.asdict(after), sort_keys=True, separators=(',', ':')).encode()).hexdigest()\n            rows.append({'case': [width, topology, seed], 'plan_sha256': digest, 'metrics': metrics})\nout = {'base_commit': revision, 'historical_selector_sha256': hashlib.sha256(ast.get_source_segment(source, node).encode()).hexdigest(), 'cases': len(rows), 'exact_plan_equal': True, 'complete_GF2_operator_accepted': True, 'rows': rows, 'driver_source': Path(__file__).read_text()}\nPath('/private/tmp/fq-trial-stream-plan-parity-20261122.json').write_text(json.dumps(out, indent=2)+'\\n')\nprint(json.dumps({k: v for k,v in out.items() if k not in ('rows', 'driver_source')}))\n"
