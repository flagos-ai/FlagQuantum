  "script": "import collections,json\nfrom pathlib import Path\np=json.loads(Path('/private/tmp/fq-commuting-frontier-screen-20261122.json').read_text())\nassert p['completed'] and len(p['rows'])==240\nrows={(r['case'],r['workflow'],r['variant']):r for r in p['rows']}\ncounts=collections.defaultdict(collections.Counter);changed=[]\nfor case in [r['case'] for r in p['inputs']]:\n for workflow in ('flagquantum-ordinary-restored','flagquantum-target-artifact'):\n  before=rows[case,workflow,'baseline'];after=rows[case,workflow,'candidate']\n  if before['status']!='accepted' or after['status']!='accepted':\n   counts[workflow]['failed_or_unsupported']+=1;continue\n  a=tuple(before['metrics'][k] for k in ('full_cz_count','two_body_dependency_depth'));b=tuple(after['metrics'][k] for k in ('full_cz_count','two_body_dependency_depth'))\n  if a==b:label='equal'\n  elif all(x<=y for x,y in zip(b,a)):label='candidate_dominates'\n  elif all(x>=y for x,y in zip(b,a)):label='candidate_dominated'\n  else:label='tradeoff'\n  counts[workflow][label]+=1\n  if a!=b:changed.append({'case':case,'workflow':workflow,'baseline':a,'candidate':b,'category':label})\nreport={'scope':'Paired inspected-case quality counts only; no independent-seed, timing, RSS, held-out or SDK-ranking claim','counts':{k:dict(v) for k,v in counts.items()},'changed':changed,'accepted':sum(r['status']=='accepted' for r in p['rows']),'attempted':len(p['rows']),'distinct_payloads':len(p['payloads']),'script':Path(__file__).read_text()}\nPath('/private/tmp/fq-commuting-frontier-analysis-20261122.json').write_text(json.dumps(report,indent=2)+'\\n')\nprint(json.dumps({k:v for k,v in report.items() if k!='script'},indent=2))\n"
