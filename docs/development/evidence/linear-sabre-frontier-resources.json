  "driver_source": "\"\"\"First-run control of source-identical SABRE frontier maintenance.\"\"\"\n\nfrom __future__ import annotations\n\nimport gc\nimport hashlib\nimport json\nimport random\nimport statistics\nimport subprocess\nimport sys\nimport time\nimport tracemalloc\nimport types\nfrom dataclasses import asdict\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nfrom flagquantum.compiler import CouplingMap, route_to_topology\nfrom flagquantum.compiler.topology import sabre\nfrom flagquantum.core.ir import CircuitIR, Instruction\n\nBASE = \"5b9cf3878664393e8667ca175ec8669f37fb3bc9\"\nOUT = Path(\"/private/tmp/fq-linear-frontier-resources-20261122.json\")\nsource = subprocess.check_output(\n    [\"git\", \"show\", BASE + \":flagquantum/compiler/topology/sabre.py\"],\n    text=True,\n    timeout=20,\n)\nold = types.ModuleType(\"flagquantum.compiler.topology._frontier_baseline\")\nold.__package__ = \"flagquantum.compiler.topology\"\nsys.modules[old.__name__] = old\nexec(compile(source, \"<frozen-main-sabre>\", \"exec\"), old.__dict__)\noriginal = old._plan_sabre_trial\ncandidate = sabre._plan_sabre_trial\nimplementations = {\"baseline\": original, \"candidate\": candidate}\nroot = Path.cwd()\nassert not subprocess.check_output([\"git\", \"status\", \"--porcelain\"], timeout=20)\nhead = subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True, timeout=20).strip()\n\n\ndef digest(value):\n    return hashlib.sha256(\n        json.dumps(value, sort_keys=True, separators=(\",\", \":\")).encode()\n    ).hexdigest()\n\n\ndef program(width, layers, mixed):\n    if not mixed:\n        return CircuitIR(\n            width,\n            tuple(\n                Instruction(\"cz\", (q, q + 1))\n                for _ in range(layers)\n                for q in range(0, width, 2)\n            ),\n        )\n    rng = random.Random(706)\n    return CircuitIR(\n        width,\n        tuple(\n            Instruction(\"cx\", tuple(rng.sample(range(width), 2)))\n            for _ in range(layers)\n        ),\n    )\n\n\nreport = {\n    \"scope\": \"Native planner and router development control; no SDK ranking or formal host qualification\",\n    \"base_commit\": BASE,\n    \"implementation_commit\": head,\n    \"baseline_source_sha256\": hashlib.sha256(source.encode()).hexdigest(),\n    \"candidate_source_sha256\": hashlib.sha256(\n        (root / \"flagquantum/compiler/topology/sabre.py\").read_bytes()\n    ).hexdigest(),\n    \"driver_sha256\": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),\n    \"driver_source\": Path(__file__).read_text(),\n    \"warmups\": 2,\n    \"retained_rounds\": 9,\n    \"rows\": [],\n    \"completed\": False,\n}\nwith OUT.open(\"x\") as stream:\n    stream.write(json.dumps(report, indent=2) + \"\\n\")\n\nfor width, layers, mixed, workflow in (\n    (256, 1024, False, \"single-trial\"),\n    (512, 512, False, \"single-trial\"),\n    (6, 64, True, \"single-trial\"),\n    (12, 128, True, \"single-trial\"),\n    (6, 64, True, \"router\"),\n    (12, 128, True, \"router\"),\n):\n    ir = program(width, layers, mixed)\n    checks = []\n\n    def run(variant, trace=False):\n        coupling = CouplingMap.line(width)\n        function = implementations[variant]\n        with patch.object(sabre, \"_plan_sabre_trial\", function):\n            if trace:\n                tracemalloc.start()\n            try:\n                started = time.perf_counter()\n                result = (\n                    function(ir, coupling)\n                    if workflow == \"single-trial\"\n                    else route_to_topology(ir, coupling, strategy=\"sabre\")\n                )\n                elapsed = time.perf_counter() - started\n                peak = tracemalloc.get_traced_memory()[1] if trace else None\n            finally:\n                if trace:\n                    tracemalloc.stop()\n        assert result is not None\n        normalized = asdict(result) if workflow == \"single-trial\" else result.to_dict()\n        return digest(normalized), elapsed, peak\n\n    expected = None\n\n    def verify(variant, phase, iteration, observed):\n        global expected\n        if expected is None:\n            expected = observed\n        assert expected == observed, (width, layers, workflow, variant, phase)\n        checks.append(\n            {\"variant\": variant, \"phase\": phase, \"iteration\": iteration, \"output_sha256\": observed}\n        )\n\n    for iteration in range(2):\n        for variant in implementations:\n            observed, _, _ = run(variant)\n            verify(variant, \"warmup\", iteration, observed)\n    samples = {variant: [] for variant in implementations}\n    for iteration in range(9):\n        order = (\"baseline\", \"candidate\") if iteration % 2 == 0 else (\"candidate\", \"baseline\")\n        for variant in order:\n            observed, elapsed, _ = run(variant)\n            verify(variant, \"timed\", iteration, observed)\n            samples[variant].append(elapsed)\n    peaks = {}\n    for variant in implementations:\n        gc.collect()\n        observed, _, peaks[variant] = run(variant, trace=True)\n        verify(variant, \"traced\", 0, observed)\n    medians = {variant: statistics.median(values) for variant, values in samples.items()}\n    row = {\n        \"width\": width,\n        \"layers_or_gates\": layers,\n        \"operation_count\": len(ir.instructions),\n        \"mixed\": mixed,\n        \"workflow\": workflow,\n        \"samples_seconds\": samples,\n        \"median_seconds\": medians,\n        \"candidate_baseline_ratio\": medians[\"candidate\"] / medians[\"baseline\"],\n        \"python_peak_bytes\": peaks,\n        \"sample_verification\": checks,\n    }\n    assert len(checks) == 24\n    report[\"rows\"].append(row)\n    OUT.write_text(json.dumps(report, indent=2) + \"\\n\")\n    print(json.dumps({k: v for k, v in row.items() if k not in (\"samples_seconds\", \"sample_verification\")}), flush=True)\n\nreport[\"completed\"] = True\nreport[\"admission_passed\"] = (\n    all(row[\"candidate_baseline_ratio\"] <= 1.05 for row in report[\"rows\"])\n    and all(row[\"candidate_baseline_ratio\"] <= .95 for row in report[\"rows\"][:2])\n    and all(\n        row[\"python_peak_bytes\"][\"candidate\"] <= 1.05 * row[\"python_peak_bytes\"][\"baseline\"]\n        and row[\"python_peak_bytes\"][\"candidate\"] <= row[\"python_peak_bytes\"][\"baseline\"] + 128 * 1024\n        for row in report[\"rows\"]\n    )\n)\nOUT.write_text(json.dumps(report, indent=2) + \"\\n\")\nassert not subprocess.check_output([\"git\", \"status\", \"--porcelain\"], timeout=20)\nprint(json.dumps({\"completed\": True, \"admission_passed\": report[\"admission_passed\"]}), flush=True)\n",
