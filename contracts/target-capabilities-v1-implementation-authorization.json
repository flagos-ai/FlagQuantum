  "legacy_contract_policy": {
    "modify_historical_contracts": false,
    "modify_compiler_target_capabilities_v1": false,
    "modify_compiler_semantic_fingerprint": false,
    "unexpressible_adapter_fields": "retain_legacy_authority_and_emit_blocker"
  }
}
