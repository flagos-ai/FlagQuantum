  "branch": "codex/open-source-api-convergence",
  "stage_name": "Deployment Bridge Stage 6",
  "distinct_from": "product-roadmap Stage 6 hybrid orchestration, every production connector, and every live-access authorization",
  "prerequisites": {
    "stage5_exit_stage6_proposal_authorization": {
      "path": "contracts/deployment-bridge-stage5-exit-stage6-proposal-authorization.json",
      "sha256": "734d9849d6b512bf0606dc5549632f90c168ee0cdcb1ae642e7475290ae51b32"
    },
    "stage5_performance_validation": {
      "path": "contracts/deployment-bridge-stage5-performance-budget-validation.json",
      "sha256": "309c709ad7091036cc5cee2422c3c779ac281a53a02cd93cf1e06e7274394a0a"
    },
    "stage5_offline_observation": {
      "path": "flagquantum/_compiler/provider_sandbox_observation.py",
      "sha256": "bc1761cf136b8c53b8b5be6d156c6daae77f83a92d8babd9aa458b0a2b915ee8"
    }
