  "objective": "Define a transport-neutral connector contract that can later support a separately approved non-billable provider sandbox while initially executing only against an in-memory scripted transport. The first implementation must prove lifecycle, idempotency, identity, error, safety and privacy semantics without network access, credential resolution, a provider SDK or a real submission.",
  "proposed_private_api": {
    "module": "flagquantum._compiler.provider_sandbox_connector",
    "operation": "run_scripted_sandbox_connector(request, attestation, credential_reference, transport, policy)",
    "inputs": [
      "immutable anonymous SandboxConnectorRequest",
      "immutable non-billable SandboxTargetAttestation",
      "opaque CredentialReference containing identity and scope but no secret",
      "ScriptedSandboxTransport with a finite immutable response transcript",
      "immutable explicit SandboxConnectorPolicy"
    ],
    "output": "immutable SandboxConnectorReport containing normalized facts and evidence only",
    "forbidden_inputs": [
      "RuntimeAdapter provider SDK HTTP client socket endpoint or network session",
      "credential token secret password private key cookie or environment variable value",
      "real production provider backend job account user or person identifier",
      "raw Circuit TargetIR executable program result payload or provider metadata",
      "retry fallback routing sampling telemetry or activation controller"
    ],
    "public_exports": [],
    "default_registration": false,
    "environment_activation": false
  },
  "operation_taxonomy": [
    "preflight",
    "submit_once",
    "read_status",
    "request_cancel",
    "read_result"
  ],
  "lifecycle_state_taxonomy": [
    "prepared",
    "admitted",
    "submission_started",
    "accepted",
    "running",
    "succeeded",
    "failed",
    "cancelled",
    "outcome_unknown"
  ],
  "terminal_state_taxonomy": [
    "succeeded",
    "failed",
    "cancelled",
    "outcome_unknown"
  ],
  "error_taxonomy": [
    "none",
    "policy_rejected",
    "target_attestation_invalid",
    "credential_reference_invalid",
    "capability_mismatch",
    "quota_or_cost_limit",
    "transport_transcript_exhausted",
    "provider_rejected",
    "provider_failed",
    "cancellation_failed",
    "submission_outcome_unknown",
    "result_invalid"
  ],
  "transport_contract": {
    "first_implementation": "finite immutable in-memory scripted transcript only",
    "allowed_operations_exactly_match_operation_taxonomy": true,
    "one_response_consumed_per_operation": true,
    "unexpected_missing_extra_or_reordered_operation": "fail_closed",
    "network_provider_sdk_socket_filesystem_environment_or_subprocess_allowed": false,
    "callback_plugin_dynamic_import_or_background_worker_allowed": false,
    "real_transport_implementation_authorized": false
  },
  "target_attestation_contract": {
    "required_fields": [
      "provider_namespace_identity",
      "sandbox_target_identity",
      "capability_identity",
      "attestation_identity",
      "non_billable",
      "sandbox_only",
      "expires_after_sequence"
    ],
    "identities_are_anonymous_lowercase_sha256": true,
    "non_billable_and_sandbox_only_must_be_true": true,
    "target_identity_enters_execution_evidence_not_program_identity": true,
    "display_name_endpoint_region_account_and_real_backend_id_accepted": false
  },
  "credential_reference_contract": {
    "fields": [
      "reference_identity",
      "provider_namespace_identity",
      "scope_identity",
      "expires_after_sequence"
    ],
    "values_are_anonymous_lowercase_sha256_or_nonnegative_sequence": true,
    "secret_value_endpoint_environment_variable_name_or_store_path_accepted": false,
    "reference_resolution_authorized": false,
    "reference_enters_program_or_artifact_identity": false,
    "reference_identity_enters_connector_evidence": true
  },
  "request_and_idempotency_contract": {
    "required_identities": [
      "request_identity",
      "program_identity",
      "artifact_identity",
      "idempotency_identity",
      "requested_target_identity"
    ],
    "submission_count": 1,
    "same_idempotency_identity_for_every_fact": true,
    "automatic_retry_allowed": false,
    "automatic_fallback_allowed": false,
    "unknown_outcome_requires_reconciliation": true,
    "unknown_outcome_allows_later_submission": false,
    "terminal_state_is_irreversible": true
  },
  "normalized_report_contract": {
    "required_facts": [
      "operations",
      "lifecycle_states",
      "terminal_state",
      "error_class",
      "request_identity",
      "program_identity",
      "artifact_identity",
      "idempotency_identity",
      "provider_namespace_identity",
      "requested_target_identity",
      "actual_target_identity",
      "credential_reference_identity",
      "quota_units",
      "cost_microunits",
      "evidence_identity"
    ],
    "provider_job_identity_accepted_in_first_implementation": false,
    "raw_provider_status_error_receipt_result_or_metadata_accepted": false,
    "actual_target_must_equal_attested_requested_target": true,
    "offline_scripted_evidence_label_required": true,
    "sandbox_or_production_certification_claim_allowed": false
  },
  "policy_and_safety_contract": {
    "required_limits": [
      "maximum operation count",
      "maximum transcript count",
      "maximum input bytes",
      "maximum evidence bytes",
      "maximum quota units",
      "maximum cost microunits",
      "maximum sequence value"
    ],
    "kill_switch_available_and_current_required": true,
    "admission_approved_required": true,
    "operator_acknowledgement_required": true,
    "rollback_evidence_required": true,
    "conformance_and_capability_match_required": true,
    "all_limits_explicit_immutable_and_fail_closed": true
  },
  "two_step_activation_contract": {
    "step_one": "approve private connector contracts scripted transport fixtures and baseline",
    "step_two": "separately approve one named live sandbox transport and credential-reference resolution after external readiness evidence",
    "step_one_authorizes_step_two": false,
    "network_or_credential_access_before_step_two": false,
    "production_target_or_billable_work_allowed_in_either_step": false
  },
  "proposed_entry_decisions": {
    "stage6_private_connector_contracts_authorized": true,
