      "operator_acknowledged",
      "rollback_verified",
      "evidence_sealed",
      "completed"
    ],
    "skipped_reordered_duplicated_or_unknown_transition": "rehearsal_failed",
    "all_actions_are_simulated_evidence_only": true,
    "state_transition_callback_or_side_effect_allowed": false,
    "production_readiness_or_activation_state_exists": false
  },
