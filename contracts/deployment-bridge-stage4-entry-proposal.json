  "objective": "Deterministically rehearse how anonymous operator roles should classify and respond to synthetic deployment-bridge failures, producing immutable evidence without performing any control-plane or data-plane action. The rehearsal must never activate a kill switch, alter admission, retry, fall back, route, dispatch, execute, submit, contact a provider, or claim production readiness.",
  "proposed_private_api": {
    "module": "flagquantum._compiler.deployment_rehearsal",
    "operation": "run_offline_deployment_rehearsal(readiness_report, scenario, observations, policy)",
    "inputs": [
      "immutable CanaryReadinessReport",
      "one closed synthetic RehearsalScenario",
      "immutable synthetic RehearsalObservationSnapshot",
      "immutable explicit RehearsalPolicy"
    ],
    "output": "immutable OfflineRehearsalReport containing simulated decisions only",
    "forbidden_inputs": [
      "RuntimeAdapter or provider SDK client",
      "ExecutionBinding SealedExecutableArtifact or TargetIR",
      "kill-switch admission routing retry or telemetry controller",
      "credentials secrets endpoints or network sessions",
      "real provider backend job account user or person identifier",
      "raw program result payload metadata receipt or diagnostic text",
      "wall-clock sleeping background work or environment activation"
    ],
    "public_exports": [],
    "default_registration": false,
    "environment_activation": false
  },
  "scenario_taxonomy": [
    "kill_switch_unavailable",
    "kill_switch_state_stale",
    "conformance_revoked",
    "target_identity_mismatch",
    "readiness_evidence_unavailable",
    "queue_budget_breach",
