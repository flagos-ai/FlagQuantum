  "unknown_submission_contract": {
    "candidate_retry_decision": "freeze",
    "automatic_legacy_fallback_submission": false,
    "receipt_or_provider_status_assumed": false,
    "reconciliation_required_before_any_later_action": true,
    "quota_and_cost_owner_required": true,
    "reason": "an unknown outcome may already represent accepted QPU work and must not be duplicated"
  },
  "synthetic_objective_contract": {
    "observations": [
      "detection_duration_ns",
      "operator_acknowledgement_duration_ns",
      "rollback_recovery_duration_ns",
      "evidence_restriction_or_deletion_duration_ns"
    ],
    "limits": [
      "maximum_detection_duration_ns",
      "maximum_operator_acknowledgement_duration_ns",
      "maximum_rollback_recovery_duration_ns",
      "maximum_evidence_restriction_or_deletion_duration_ns"
    ],
    "durations_are_caller_supplied_nonnegative_synthetic_values": true,
    "wall_clock_or_sleep_used": false,
    "objective_breach_outcome": "offline_rehearsal_failed",
    "objective_values_enter_evidence_identity": true
  },
  "privacy_identity_and_report_contract": {
    "report_fields": [
      "scenario",
      "outcome",
      "states",
      "simulated_actions",
      "responsible_roles",
      "readiness_evidence_identity",
      "observation_identity",
      "policy_identity",
      "objective_results",
      "evidence_identity"
    ],
    "person_provider_backend_job_account_user_or_credential_included": false,
    "raw_program_result_payload_metadata_receipt_or_diagnostic_included": false,
    "timestamps_environment_values_and_display_labels_in_identity": false,
    "scenario_actions_roles_objectives_and_parent_identities_in_identity": true,
    "anonymous_deterministic_identity_required": true
  },
  "resource_and_isolation_contract": {
    "policy_is_explicit_and_immutable": true,
    "required_limits": [
      "maximum scenario count",
      "maximum state transitions",
      "maximum simulated actions",
      "maximum input bytes",
      "maximum evidence bytes",
      "maximum synthetic objective values"
    ],
    "one_scenario_per_invocation": true,
    "input_snapshots_mutated": false,
    "global_registry_cache_queue_or_worker_allowed": false,
    "callback_hook_controller_or_plugin_allowed": false,
    "filesystem_environment_network_or_background_work_allowed": false,
    "limit_breach_fails_closed": true
  },
  "completion_rule": {
    "offline_rehearsal_passed_requires": [
      "exact expected state sequence",
      "all scenario-required simulated actions",
      "all scenario-required anonymous roles",
      "all synthetic objectives within explicit limits",
      "immutable evidence within size limits"
    ],
    "passed_means_production_ready": false,
    "passed_authorizes_canary_activation": false,
    "passed_authorizes_provider_sandbox": false,
    "passed_authorizes_runtime_integration": false
  },
  "required_evidence_if_entry_approved": [
    "all thirteen anonymous scenarios have deterministic golden evidence",
    "runtime taxonomies exactly match the approved proposal",
    "transition omission reordering duplication and unknown values fail closed",
    "missing required simulated action or anonymous role fails closed",
    "each synthetic objective boundary and breach is tested",
    "unknown submission always freezes candidate retry and never requests fallback submission",
    "sensitive or executable inputs cannot enter report fields or identities",
    "inputs remain unchanged and no callback controller global state or background work exists",
    "evidence identities remain stable across Python hash seeds",
    "independent 10 100 1K and 10K rehearsal baseline precedes any performance budget",
    "public API deployment provider runtime shadow and default paths remain unchanged"
  ],
