    "fingerprint_fields": [
      "program",
      "options",
      "environment",
      "compiler"
    ],
    "extension_identity_fields": [
      "namespace",
      "kind",
      "version",
      "identity"
    ],
    "format": "canonical_json",
    "pickle_allowed": false,
    "unknown_top_level_fields_fail": true,
    "identity_recomputed_on_read": true
  },
  "identity_inputs": [
    "execution_plan_schema_and_version",
    "program_fingerprint",
    "resolved_execution_semantics",
    "compiler_fingerprint",
    "required_environment_constraints",
    "selected_execution_decision",
    "versioned_extension_identities"
  ],
  "identity_exclusions": [
    "created_at",
    "runtime_duration",
    "hostname",
    "pid",
    "rank_id",
    "instantaneous_available_memory",
    "performance_counters",
    "mapping_insertion_order",
    "python_repr",
    "object_address",
    "log_path",
    "cache_path",
    "credentials",
    "provider_transport_metadata"
  ],
  "plan_input_rules": {
    "options_must_be_none": true,
    "measurements_must_be_none": true,
    "noise_model_must_be_none": true,
