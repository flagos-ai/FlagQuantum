      {"name": "compiler_fingerprint", "type": "str"},
      {"name": "mode", "type": "str"},
      {"name": "backend", "type": "str"},
      {"name": "device", "type": "str"},
      {"name": "target", "type": "str"},
      {"name": "batch_size", "type": "int"},
      {"name": "precision", "type": "str"},
      {"name": "world_size", "type": "int"},
      {"name": "state_bytes", "type": "int"},
      {"name": "is_distributed", "type": "bool"}
    ],
    "methods": [
      "summary",
      "to_dict",
      "to_json",
      "from_dict",
      "from_json"
    ]
  },
  "serialization": {
    "required_top_level_fields": [
      "schema",
      "version",
      "identity",
      "program",
      "requested_options",
      "resolved_options",
      "fingerprints",
      "environment_requirements",
      "decision",
      "extensions"
