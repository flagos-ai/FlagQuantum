  "stale_reason_codes": [
    "unsupported_schema",
    "identity_mismatch",
    "program_fingerprint_mismatch",
    "options_fingerprint_mismatch",
    "compiler_incompatible",
    "environment_incompatible",
    "backend_unavailable",
    "world_size_mismatch",
    "extension_incompatible"
  ],
  "boundaries": {
