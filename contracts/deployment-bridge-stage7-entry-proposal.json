    "credential_reference_resolution_authorized": false,
    "real_backend_or_job_identity_authorized": false,
    "real_execution_or_submission_authorized": false,
    "retry_or_fallback_authorized": false,
    "production_target_authorized": false,
    "shadow_canary_or_request_routing_authorized": false,
    "telemetry_export_authorized": false,
    "deployment_migration_authorized": false,
    "public_api_change_authorized": false,
    "default_path_change_authorized": false,
    "legacy_retirement_authorized": false,
    "product_roadmap_stage7_authorized": false,
    "unified_ir_phase4_entry_authorized": false
  },
  "next_owner_action": {
    "action": "select exactly one Provider and one documented non-billable sandbox target",
    "entry_approval_available_now": false,
    "required_form": "approve DEPLOYMENT-BRIDGE-STAGE7-PROVIDER-SELECTION provider=<canonical-provider-namespace> sandbox=<documented-non-billable-sandbox-target>",
    "pause_after": "Provider selection evidence capture and independent Stage 7 Entry review"
  }
}
