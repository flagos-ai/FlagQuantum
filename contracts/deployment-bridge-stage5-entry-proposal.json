{
  "schema_version": "1.0",
  "proposal": "deployment-bridge-stage5-provider-sandbox-observation",
  "status": "ready_for_owner_review_implementation_not_authorized",
  "created_at": "2026-09-03",
  "branch": "codex/open-source-api-convergence",
  "stage_name": "Deployment Bridge Stage 5",
  "distinct_from": "product-roadmap Stage 5 classic-compute-cloud control plane, every live provider integration, and every production canary",
  "prerequisites": {
    "stage4_exit_stage5_proposal_authorization": {
      "path": "contracts/deployment-bridge-stage4-exit-stage5-proposal-authorization.json",
      "sha256": "aa573bea5a32cc1b8f5803cba78fe54cac5440074c4d3d87f58a493482f75a97"
    },
    "stage4_performance_validation": {
      "path": "contracts/deployment-bridge-stage4-performance-budget-validation.json",
      "sha256": "b0863f404a3a32187525afb4fafff17e5f363dd79e3167ab1f0e6dc27c2f47dc"
    },
    "stage4_offline_rehearsal": {
      "path": "flagquantum/_compiler/deployment_rehearsal.py",
      "sha256": "f1d809443f8956f27b08f654fff7109a584ec0a2cff09ad69fbcccd90d7925a4"
    }
  },
  "objective": "Validate caller-supplied immutable facts representing one synthetic provider-sandbox observation, preserving target, lifecycle, idempotency, quota, cost and safety provenance without importing a provider SDK, opening a network session, resolving credentials, creating a job or performing submission.",
  "proposed_private_api": {
    "module": "flagquantum._compiler.provider_sandbox_observation",
    "operation": "evaluate_provider_sandbox_observation(readiness_report, rehearsal_report, observation, policy)",
    "inputs": [
      "immutable CanaryReadinessReport",
      "immutable OfflineRehearsalReport",
      "immutable anonymous SandboxObservationSnapshot",
      "immutable explicit SandboxObservationPolicy"
    ],
    "output": "immutable SandboxObservationReport containing validation decisions only",
    "forbidden_inputs": [
      "RuntimeAdapter provider SDK client transport callback or network endpoint",
      "ExecutionBinding SealedExecutableArtifact TargetIR or raw program",
      "credential secret token session account or personal identifier",
      "real provider backend job or billable resource identifier",
      "raw result payload receipt diagnostic log or provider metadata",
      "routing retry fallback telemetry or control-plane controller"
    ],
    "public_exports": [],
    "default_registration": false,
    "environment_activation": false
  },
  "observation_state_taxonomy": [
    "not_attempted",
    "intent_recorded",
    "attempt_recorded",
    "acceptance_confirmed",
    "acceptance_rejected",
    "terminal_result_recorded",
    "outcome_unknown"
  ],
  "decision_taxonomy": [
    "observation_accepted",
    "observation_rejected",
    "reconciliation_required",
    "observation_incomplete"
  ],
  "identity_contract": {
    "required_anonymous_identities": [
      "sandbox_target_identity",
      "request_identity",
      "idempotency_identity",
      "observation_identity",
      "readiness_evidence_identity",
      "rehearsal_evidence_identity"
    ],
    "program_identity_equals_request_identity": false,
    "request_identity_equals_provider_job_identity": false,
    "provider_job_identity_accepted": false,
    "identity_values_are_fixed_lowercase_sha256": true,
    "display_names_endpoints_credentials_and_raw_payloads_in_identity": false
  },
  "lifecycle_contract": {
    "normal_orders": [
      ["not_attempted"],
      ["intent_recorded", "attempt_recorded", "acceptance_rejected"],
      ["intent_recorded", "attempt_recorded", "acceptance_confirmed", "terminal_result_recorded"],
      ["intent_recorded", "attempt_recorded", "outcome_unknown"]
    ],
    "acceptance_confirmed_requires_attempt_recorded": true,
    "terminal_result_requires_acceptance_confirmed": true,
    "skipped_reordered_duplicated_or_unknown_state": "observation_rejected",
    "state_callback_or_side_effect_allowed": false
  },
  "unknown_submission_contract": {
    "decision": "reconciliation_required",
    "same_idempotency_identity_must_be_preserved": true,
    "automatic_retry_allowed": false,
    "automatic_fallback_allowed": false,
    "provider_acceptance_assumed": false,
    "quota_or_cost_refund_assumed": false,
    "later_submission_allowed_before_reconciliation": false
  },
  "safety_evidence_contract": {
    "readiness_result_required": "ready_for_separate_activation_review",
    "rehearsal_result_required": "offline_rehearsal_passed",
    "matching_readiness_evidence_identity_required": true,
    "kill_switch_available_and_current_required": true,
    "rollback_evidence_required": true,
    "operator_acknowledgement_required": true,
    "conformance_current_required": true,
    "target_identity_match_required": true,
    "non_billable_synthetic_workload_required": true,
    "any_missing_stale_mismatched_or_ambiguous_evidence": "observation_rejected"
  },
  "quota_cost_and_retention_contract": {
    "caller_supplied_nonnegative_observations": [
      "observed_queue_depth",
      "observed_quota_units",
      "observed_cost_microunits",
      "observed_retention_duration_ns"
    ],
    "explicit_nonnegative_policy_limits": [
      "maximum_queue_depth",
      "maximum_quota_units",
      "maximum_cost_microunits",
      "maximum_retention_duration_ns"
    ],
    "limit_breach_decision": "observation_rejected",
    "provider_billing_or_quota_api_accessed": false,
    "wall_clock_or_environment_read": false
  },
  "privacy_and_isolation_contract": {
    "anonymous_synthetic_fixtures_only": true,
    "credential_handle_value_accepted": false,
    "person_account_provider_backend_or_job_identifier_accepted": false,
    "raw_program_result_receipt_metadata_diagnostic_or_log_accepted": false,
    "input_snapshots_mutated": false,
    "global_registry_cache_queue_worker_or_filesystem_allowed": false,
    "callback_hook_controller_plugin_or_transport_allowed": false,
    "environment_network_or_background_work_allowed": false
  },
  "completion_rule": {
    "observation_accepted_requires": [
      "successful and identity-matched readiness and rehearsal evidence",
      "exact valid lifecycle order ending in terminal_result_recorded",
      "current kill-switch rollback conformance and operator evidence",
      "matching anonymous sandbox target and request facts",
      "non-billable synthetic workload declaration",
      "quota cost queue and retention observations within explicit limits"
    ],
    "accepted_means_provider_integration_ready": false,
    "accepted_means_production_ready": false,
    "accepted_authorizes_execution_or_submission": false,
    "accepted_authorizes_retry_fallback_shadow_or_canary": false
  },
  "proposed_entry_decisions": {
    "stage5_private_offline_observation_evaluator_authorized": true,
    "stage5_anonymous_synthetic_fixtures_authorized": true,
    "stage5_independent_performance_baseline_authorized": true,
    "stage5_performance_budget_approved": false,
    "stage5_live_sandbox_integration_authorized": false,
    "runtime_adapter_access_authorized": false,
    "provider_sdk_or_network_authorized": false,
    "credential_access_authorized": false,
    "real_backend_or_job_identity_authorized": false,
    "execution_or_submission_authorized": false,
    "shadow_or_dual_execution_authorized": false,
    "canary_activation_authorized": false,
    "sampling_or_request_routing_authorized": false,
    "telemetry_export_authorized": false,
    "deployment_migration_authorized": false,
    "public_api_change_authorized": false,
    "default_path_change_authorized": false,
    "legacy_retirement_authorized": false,
    "unified_ir_phase4_entry_authorized": false
  },
  "explicit_exclusions": {
    "live_provider_or_sandbox_contact": false,
    "runtime_adapter_or_transport_access": false,
    "provider_sdk_or_network_access": false,
    "credential_or_secret_access": false,
    "real_backend_job_account_or_person_identity": false,
    "artifact_creation_execution_or_submission": false,
    "retry_fallback_shadow_canary_sampling_or_routing": false,
    "telemetry_export_or_deployment_migration": false,
    "public_or_default_path_change": false,
    "legacy_retirement_or_unified_ir_phase4_entry": false
  },
  "approval_command": "approve DEPLOYMENT-BRIDGE-STAGE5-ENTRY",
  "pause_after": "Stage 5 private offline observation evaluator, independent baseline, and performance-budget review"
}
