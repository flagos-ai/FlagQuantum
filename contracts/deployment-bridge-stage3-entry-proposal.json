    "at_most_one_candidate_dispatch_per_attempt_identity": true,
    "retry_after_definite_pre_submission_failure": "allowed_only_by_later_explicit_policy",
    "retry_after_unknown_or_possible_submission": false,
    "reason": "unknown submission state must not trigger duplicate QPU work quota consumption billing or conflicting receipts"
  },
  "kill_switch_and_rollback_contract": {
    "kill_switch_fail_closed": true,
    "kill_switch_independent_from_candidate_runtime": true,
    "named_human_owner_required": true,
    "machine_readable_state_and_last_change_identity_required": true,
    "kill_switch_precedes_sampling_and_dispatch": true,
    "in_flight_work_policy_required": true,
    "rollback_target": "unchanged authoritative legacy DeploymentPackage path",
    "rollback_requires_package_or_receipt_rewrite": false,
    "rollback_recovery_objective_required": true,
    "mandatory_triggers": [
      "any semantic correctness mismatch",
      "artifact binding receipt or result identity discontinuity",
      "credential user-data or provider-locator privacy exposure",
      "latency memory queue quota or cost budget breach",
      "provider conformance expiry revocation or target mismatch",
      "kill-switch audit or dispatch-idempotency evidence unavailable",
      "public API serialized package or default-path incompatibility"
    ]
  },
  "budget_contract": {
    "budgets_required": [
      "semantic correctness and statistical equivalence",
      "privacy and evidence bytes",
      "admission and candidate latency",
      "host and accelerator memory",
      "sampling count and rate",
      "concurrency and in-flight work",
      "queue age and timeout",
      "provider quota consumption",
      "per-request and aggregate monetary cost"
    ],
    "numeric_thresholds_authorized_now": false,
    "independent_anonymous_baseline_before_budget_proposal": true,
    "budget_requires_separate_owner_approval": true,
    "budget_breach_action": "block new admission and request kill-switch evaluation",
    "public_sla_claimed": false
  },
  "provider_conformance_contract": {
    "existing_provider_neutral_harness_is_sufficient_for_real_provider": false,
    "provider_adapter_target_profile_and_version_bound_attestation_required": true,
    "required_checks": [
      "canonical target capability completeness",
      "artifact profile and media type acceptance",
      "submission idempotency or explicit non-idempotency",
      "status lifecycle and terminal-state monotonicity",
      "cancel and timeout semantics",
      "receipt result and target identity continuity",
      "quota queue billing and uncertain-submission semantics",
      "credential and provider-locator isolation",
      "revocation expiry and rollback behavior"
    ],
    "real_provider_sdk_or_network_allowed_in_stage3": false,
    "real_provider_attestation_creation_authorized_in_stage3": false,
    "anonymous_synthetic_attestations_only": true
  },
  "observability_identity_and_privacy_contract": {
    "portable_evidence_fields": [
      "readiness status and closed findings",
      "Stage 2 evidence identity",
      "target capability fingerprint",
      "artifact profile",
