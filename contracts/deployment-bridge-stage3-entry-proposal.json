  ],
  "admission_contract": {
    "explicit_per_request_opt_in_required": true,
    "environment_variable_or_global_opt_in_allowed": false,
    "default_requests_admitted": false,
    "successful_stage2_report_required": true,
    "exact_program_target_profile_and_policy_identity_match_required": true,
