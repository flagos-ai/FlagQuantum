  "objective": "Offline and deterministically decide whether a completed Stage 2 dry-run evidence report and anonymous operational-control attestations satisfy the prerequisites for a separate canary activation review. The evaluator must never activate, sample, dispatch, execute, submit, resolve a real target, access a runtime adapter, or mutate the authoritative legacy path.",
  "current_readiness": {
    "stage1_offline_compatibility_complete": true,
    "stage2_explicit_offline_dry_run_complete": true,
    "private_provider_neutral_conformance_harness_exists": true,
    "real_provider_adapter_conformance_approved": false,
    "production_kill_switch_implemented_and_independently_owned": false,
    "production_observability_retention_and_deletion_approved": false,
    "production_queue_quota_and_cost_controls_approved": false,
    "real_execution_or_submission_authorized": false,
    "canary_ready_now": false,
    "canary_activation_authorized": false
  },
  "proposed_private_api": {
    "module": "flagquantum._compiler.deployment_canary_readiness",
    "operation": "evaluate_deployment_canary_readiness(dry_run_report, conformance, controls, policy)",
    "inputs": [
      "immutable successful DeploymentDryRunReport",
      "immutable anonymous ProviderConformanceAttestation",
      "immutable anonymous CanaryControlSnapshot",
      "immutable explicit CanaryReadinessPolicy"
    ],
    "output": "immutable CanaryReadinessReport containing readiness evidence only",
    "forbidden_inputs": [
      "RuntimeAdapter",
      "ExecutionBinding",
      "SealedExecutableArtifact or TargetIR",
      "provider SDK client",
      "credentials or secrets",
      "real provider backend or job identifier",
      "network endpoint",
      "raw program result payload metadata or diagnostic text"
    ],
    "public_exports": [],
    "default_registration": false,
    "environment_activation": false
  },
  "readiness_status_taxonomy": [
    "blocked",
    "eligible_for_offline_rehearsal",
    "ready_for_separate_activation_review"
  ],
