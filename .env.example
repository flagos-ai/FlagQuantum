# Copy this file to .env and replace only the placeholders you need locally.
# .env is ignored by Git and must never be committed.

# Preferred Quafu Task API. QUAFU_TASK_SERVER_URL is optional when the
# production default is correct.
QUAFU_API_KEY=replace-with-your-quafu-api-key
QUAFU_TASK_SERVER_URL=https://quafu.com.cn/api/v1

# Optional legacy SQC fallback and locally compiled QSteed submissions.
QUAFU_API_TOKEN=replace-with-your-legacy-quafu-token

# Required only when controlling a Jiuding workspace from outside its pod.
JIUDING_AK=replace-with-your-jiuding-ak
JIUDING_SK=replace-with-your-jiuding-sk
JIUDING_WORKSPACE=example-resident-a100

# Optional QBoson Kaiwu/QDiffusion live examples. The SDK code is secret;
# the user and project identifiers should also remain in the private runtime
# environment. Live examples additionally require their documented approval,
# resource, quota, and private-evidence gates.
QBOSON_USER_ID=replace-with-your-qboson-user-id
QBOSON_SDK_CODE=replace-with-your-qboson-sdk-code
QBOSON_PROJECT_NO=replace-with-your-qboson-project-number
