# Copy this file to .env and replace the placeholder locally.
# .env is ignored by Git and must never be committed.
QUAFU_API_TOKEN=replace-with-your-quafu-token

# Required only when controlling a Jiuding workspace from outside its pod.
JIUDING_AK=replace-with-your-jiuding-ak
JIUDING_SK=replace-with-your-jiuding-sk
JIUDING_WORKSPACE=flagquantum-runtime-a100
